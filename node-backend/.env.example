# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string (free tier): sign up at mongodb.com/cloud/atlas,
# create a free cluster, click "Connect" -> "Drivers", copy the connection string here.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/maildrishti?retryWrites=true&w=majority

# Any long random string — used to sign JWT login tokens. Change this to something
# unique before your actual demo/finale (don't use this exact value).
JWT_SECRET=change_this_to_a_long_random_string_before_demo

# Where the Python AI module (FastAPI) is running — this is the backend we already
# built and tested. Keep it running on this port while the Node server runs.
PYTHON_AI_SERVICE_URL=http://localhost:8000

# Port this Node/Express server listens on. React frontend should call THIS port,
# not the Python one directly.
PORT=5000
